---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Oriol Martín Olivé — Software Engineer',
	description = 'Software Engineer in Barcelona building scalable web applications and production-grade Generative AI systems.',
} = Astro.props;
---
<!doctype html>
<html lang="en" class="scheme-light scroll-smooth scroll-pt-6 motion-reduce:scroll-auto">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F2F0EF" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="m-0 min-w-[320px] bg-bg font-body text-base leading-[1.65] text-primary antialiased selection:bg-primary selection:text-bg motion-reduce:[&_*]:animate-none motion-reduce:[&_*]:transition-none">
		<a
			class="fixed left-4 top-4 z-[100] -translate-y-[180%] rounded-full bg-accent px-4 py-3 text-sm font-bold text-bg no-underline transition-transform duration-[160ms] focus:translate-y-0 motion-reduce:transition-none"
			href="#main"
		>
			Skip to main content
		</a>
		<slot />
	</body>
</html>
