---
import type { SkillGroup } from '../../data/portfolio';

interface Props {
	skillGroups: SkillGroup[];
}

const { skillGroups } = Astro.props;
---

<section
	class="border-t border-border py-[clamp(4.5rem,8vw,7rem)]"
	id="skills"
	aria-labelledby="skills-title"
>
	<div class="mb-12 grid grid-cols-[minmax(145px,0.5fr)_minmax(0,1.6fr)] gap-10 max-[720px]:mb-[2.2rem] max-[720px]:grid-cols-1 max-[720px]:gap-[1.1rem]">
		<p class="pt-[0.45rem] font-mono text-[0.68rem] font-semibold tracking-[0.09em] uppercase leading-[1.5] opacity-[0.82] max-[720px]:pt-0">
			<span class="mr-[0.35rem] opacity-[0.72]">04</span> / Skills
		</p>
		<div>
			<h2 class="max-w-[18ch] font-display text-[clamp(2.45rem,4.7vw,4.1rem)] font-normal tracking-[-0.06em] leading-[1.04]" id="skills-title">
				Tools for thoughtful engineering.
			</h2>
			<p class="mt-4 max-w-[56ch] text-[0.9rem] opacity-[0.82]">
				Technologies, practices, and languages I bring to product development.
			</p>
		</div>
	</div>

	<div class="grid grid-cols-3 gap-[0.8rem] max-[720px]:grid-cols-2 max-[480px]:grid-cols-1">
		{skillGroups.map((group) => (
			<article class="min-h-full rounded border border-border bg-[rgba(255,255,255,0.28)] px-5 pt-[1.35rem] pb-6">
				<div class="flex items-baseline gap-[0.65rem] border-b border-border pb-[0.8rem]">
					<span class="font-mono text-[0.62rem] opacity-[0.68]">{group.number}</span>
					<h3 class="text-[0.86rem] font-bold tracking-[-0.015em] leading-[1.4]">{group.title}</h3>
				</div>
				<ul class="mt-4 flex flex-wrap gap-[0.42rem]">
					{group.items.map((item) => (
						<li class="rounded-full border border-[rgba(187,189,188,0.8)] px-2 py-[0.29rem] text-[0.66rem] leading-[1.4]">
							{item}
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</section>
